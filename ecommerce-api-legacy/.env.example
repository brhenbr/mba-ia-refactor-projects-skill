# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA commite o arquivo ".env".

NODE_ENV=development
PORT=3000

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=changeme-generate-a-random-64-char-hex-value
JWT_EXPIRES_IN=1h

BCRYPT_ROUNDS=10

# Chave do gateway de pagamento (mock) — nunca commitar valores reais.
PAYMENT_GATEWAY_KEY=pk_live_replace_me
