# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA commite o arquivo ".env".

FLASK_ENV=development

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme-generate-a-random-64-char-hex-value
JWT_SECRET_KEY=changeme-generate-a-different-random-64-char-hex-value

DATABASE_URL=sqlite:///tasks.db

# Lista separada por vírgula de origens permitidas para CORS (sem espaços)
CORS_ORIGINS=http://localhost:3000

# Opcional: se não configurado, o envio de email é apenas logado (não falha a request)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
